# Raw infrastructure evidence must be reviewed and sanitized before versioning.
/evidence/*
!/evidence/README.md
!/evidence/sanitized/
!/evidence/sanitized/*.json

# Local, unsanitized Stage 1 service-test output.
/implementation/**/.local-evidence/

# Python bytecode generated by local validation.
__pycache__/
*.py[cod]

# Local, unsanitized Stage 1 service-test output.
/implementation/**/.local-evidence/
